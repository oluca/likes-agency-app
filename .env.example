# Render API (server-only, never exposed to the browser)
API_BASE_URL=https://api.likes.agency
API_KEY=
# Upload limit in MB, checked in the browser and in the proxy (default 500)
MAX_UPLOAD_MB=500

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Lets the app write system-owned job columns (status, durations, billing).
SUPABASE_SERVICE_ROLE_KEY=
